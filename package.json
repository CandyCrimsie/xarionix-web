{
  "name": "xarionix-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve xarionix-web",
    "build": "ng build xarionix-web",
    "watch": "ng build xarionix-web --watch --configuration development",
    "test": "ng test xarionix-web",
    "console:start": "ng serve xarionix-console --port 4300 --proxy-config projects/xarionix-console/proxy.conf.cjs",
    "console:build": "ng build xarionix-console",
    "console:typecheck": "tsc --noEmit -p projects/xarionix-console/tsconfig.app.json",
    "console:test": "ng test xarionix-console --watch=false",
    "console:lint": "prettier --check src/app/platform projects/xarionix-console/src projects/xarionix-console/e2e projects/xarionix-console/public/*.json projects/xarionix-console/production/*.json projects/xarionix-console/tsconfig*.json scripts/*console*.mjs && node scripts/check-console.mjs",
    "console:bundle-check": "node scripts/check-console-bundle.mjs",
    "console:security": "node scripts/console-security.mjs",
    "console:e2e": "../xarionix-core/.venv/bin/python scripts/console_integration.py --core ../xarionix-core",
    "erp:legacy:build": "ng build xarionix-erp-legacy",
    "erp:legacy:start": "ng serve xarionix-erp-legacy",
    "web:typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "21.0.0",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@solar-icons/angular": "^2.1.0",
    "@spartan-ng/brain": "1.3.4",
    "@tanstack/angular-table": "^9.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^21.0.0",
    "maplibre-gl": "^6.15.0",
    "ngx-scrollbar": "^19.1.5",
    "oidc-client-ts": "3.5.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.26",
    "@playwright/test": "^1.64.1",
    "@spartan-ng/cli": "^1.3.4",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
